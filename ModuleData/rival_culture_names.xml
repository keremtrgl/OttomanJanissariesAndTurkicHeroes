<?xml version="1.0" encoding="utf-8"?>
<SPCultures>
  <!-- Character-creation culture-select screen shows the raw Culture name, not the Kingdom
       name - renamed here so a new character can be created directly as Byzantine/Abbasid/
       Georgian, matching their kingdom names. Culture.empire is shared by empire/empire_s/
       empire_w (Western/Southern/Northern Empire successor states) - only empire_s is renamed
       to "Byzantine Empire" as a kingdom, so Northern/Western Empire will also display the
       Culture name "Byzantine" at character creation and anywhere else Culture.name is shown
       (confirmed acceptable: historically all three successor states were the same Roman/
       Byzantine civilization, so this isn't factually wrong, just broader than only empire_s -
       a real decision, not an oversight). Culture.aserai/Culture.sturgia each belong to exactly
       one kingdom of ours, so no such spillover exists for Abbasid/Georgian. -->
  <!-- basic_troop/elite_basic_troop redirect Byzantine/Abbasid recruitment to the fully
       independent troop trees in byzantine_custom_troops.xml/abbasid_custom_troops.xml -
       every notable/garrison in empire_s or aserai now offers those instead of Native's
       imperial_recruit/aserai_recruit. Since Culture.empire is shared, this also applies to
       Northern/Western Empire recruitment (same accepted tradeoff as the name above). -->
  <Culture id="empire" name="{=byz_culture_name}Byzantine" basic_troop="NPCCharacter.byz2_recruit" elite_basic_troop="NPCCharacter.byz2_klibanophoros" />
  <Culture id="aserai" name="{=abb_culture_name}Abbasi" basic_troop="NPCCharacter.abb2_recruit" elite_basic_troop="NPCCharacter.abb2_ghulam" />
  <Culture id="sturgia" name="{=geo_culture_name}Gürcü" />
</SPCultures>
