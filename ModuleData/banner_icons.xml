<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" type="string">
  <BannerIconData>
    <!-- ================================================================================= -->
    <!-- BÜYÜK SELÇUKLU VE TÜRK SANCAK İKONLARI GRUBU (TURKIC & SELJUK BANNER ICONS)        -->
    <!-- ================================================================================= -->
    <BannerIconGroup id="7" name="{=str_banner_seljuk_group}Seljuk &amp; Turkic Tamgas" is_pattern="false">
      <!--
        NOT: Icon id değerleri Native/ModuleData/banner_icons.xml içindeki mevcut
        ikonlarla (id aralığı 100-535) ÇAKIŞMAYACAK şekilde 900+ bloğuna taşındı.
        Eskiden bu grup native ikonlarla AYNI id'leri (103, 116, 133, 301, 401, 428,
        432, 434, 435, 505, 510) yeniden tanımlıyordu; bu "duplicate key" kaydı motorun
        banner ikon kayıt defterinde çakışmaya yol açıyor ve New Campaign ekranına
        girerken (banner düzenleyici ilk kez tetiklendiğinde) oyunun çökmesine/donmasına
        sebep oluyordu. material_name/texture_index değerleri aynı bırakıldı, yalnızca
        id numaraları değişti; görünümler birebir korunur.
      -->
      <!-- 1. Çift Başlı Selçuklu Kartalı -->
      <Icon id="900" material_name="custom_banner_icons_01" texture_index="11" />

      <!-- 2. Kayı Boyu (IYI) Damgası -->
      <Icon id="901" material_name="custom_banner_icons_02" texture_index="7" />

      <!-- 3. Tuğrul Bey & Bozkır Ok-Yay Tamgası -->
      <Icon id="902" material_name="custom_banner_icons_10" texture_index="10" />

      <!-- 4. Selçuklu 8 Köşeli Adalet Yıldızı -->
      <Icon id="903" material_name="custom_banner_icons_14" texture_index="12" />

      <!-- 5. Hilal ve Yıldız / Üç Hilal Tamgası -->
      <Icon id="904" material_name="custom_banner_icons_09" texture_index="13" />

      <!-- 6. Zülfikar ve Şemşir Kılıç Tamgası -->
      <Icon id="905" material_name="custom_banner_icons_11" texture_index="15" />

      <!-- 7. Çaka Beyliği Sahil & Denizci Hilali -->
      <Icon id="906" material_name="custom_banner_icons_06" texture_index="13" />

      <!-- 8. Saltuklu Dağ ve Bozkır Kurdu Tamgası -->
      <Icon id="907" material_name="custom_banner_icons_03" texture_index="9" />

      <!-- 9. Mengücek Çelik, Maden ve İstihkam Tamgası -->
      <Icon id="908" material_name="custom_banner_icons_04" texture_index="9" />

      <!-- 10. Ahi Evran Mizan ve Fütüvvet Tamgası -->
      <Icon id="909" material_name="custom_banner_icons_04" texture_index="7" />

      <!-- 11. Hakan Güneş Kursu -->
      <Icon id="910" material_name="custom_banner_icons_14" texture_index="6" />

      <!-- 12. Kızıl Sancak: Hilal ve Yıldız (kullanıcı istekli bayrak - kırmızı zemin üstünde beyaz hilal-yıldız) -->
      <Icon id="911" material_name="custom_banner_icons_09" texture_index="13" />

      <!-- 13. Gök Sancak: Çift Başlı Kartal (kullanıcı istekli bayrak - mavi zemin üstünde beyaz çift başlı kartal) -->
      <Icon id="912" material_name="custom_banner_icons_01" texture_index="11" />
    </BannerIconGroup>
  </BannerIconData>
</base>
