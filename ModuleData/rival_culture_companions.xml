<?xml version="1.0" encoding="utf-8"?>
<!-- Historical wanderer companions for all 7 playable cultures (Latin Empire shares Culture.empire
     with Byzantium, so its own taverns already draw from the empire pool below). Each is a real
     11th/12th-century figure - not a generic "{FIRSTNAME} the X" template like Native's own
     wanderers - built the same way Native itself builds any companion: is_template="true" +
     occupation="Wanderer" is what TaleWorlds.CampaignSystem.CampaignBehaviors.CompanionsCampaignBehavior
     actually scans for (InitializeCompanionTemplateList, decompiled), so a plain is_hero="true"
     NPCCharacter would silently never spawn in any tavern. Because _aliveCompanionTemplates is a
     per-template HashSet, only one living instance of each of these 14 exists in the campaign at a
     time, same as any Native companion. culture= only steers their home/creation settlement and
     starting body-property range - Bannerlord scatters all companions across every culture's towns
     regardless, so any of these can turn up in any kingdom's tavern, same as Native's own roster. -->
<NPCCharacters>

  <!-- ===================== SELJUK (Culture.seljuk) ===================== -->

  <!-- Nasir Khusraw (1004-1088): Persian poet-philosopher and Ismaili missionary who spent seven
       years traveling in disguise across the Islamic world, recorded in his travelogue Safarnama. -->
  <NPCCharacter id="spc_wanderer_seljuk_khusraw" name="{=spc_wc_khusraw_name}Nasir Khusraw" voice="softspoken" age="45"
      default_group="Infantry" is_template="true" is_hero="false" culture="Culture.seljuk"
      occupation="Wanderer">
    <face>
      <face_key_template value="BodyProperty.villager_khuzait" />
    </face>
    <skills>
      <skill id="Scouting" value="85" />
      <skill id="Roguery" value="65" />
      <skill id="Charm" value="55" />
      <skill id="Steward" value="35" />
      <skill id="Medicine" value="20" />
    </skills>
    <Traits>
      <Trait id="Honor" value="1" />
      <Trait id="Valor" value="1" />
      <Trait id="Calculating" value="1" />
    </Traits>
    <Equipments>
      <EquipmentSet id="npc_companion_equipment_template_khuzait" equipmentType="Civilian" />
      <EquipmentSet id="npc_companion_equipment_template_khuzait" />
    </Equipments>
