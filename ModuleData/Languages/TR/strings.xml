  <string id="seljuk_v_palu" text="Palu" /><string id="seljuk_v_keban" text="Keban" /><string id="seljuk_castle_harep" text="Harput Kalesi" /><string id="item_seljuk_ghulam_armor" text="Selçuklu Gulam Çar-Ayine Zırhı" /><string id="item_seljuk_gazi_armor" text="Danişmendiye Uç Beyi Zırhı" /><string id="item_seljuk_royal_helm" text="Sultan Hassa Şeref Miğferi" /><string id="item_seljuk_spiked_helm" text="Selçuklu Zırhlı Boyunluklu Tolgası" /><string id="item_seljuk_fur_helm" text="Kayı Gazi Kürklü Tolgası" /><string id="item_seljuk_pauldrons" text="Selçuklu Hassa Plaka Omuzlukları" /><string id="item_seljuk_bracers" text="Gazi Şam Çeliği Kolçakları" /><string id="item_seljuk_boots" text="Sahtiyan Selçuklu Süvari Çizmeleri" /><string id="item_seljuk_inf_shield" text="Selçuklu Nizam Piyade Kalkanı" /><string id="item_seljuk_composite_bow" text="Oğuz Atabeg Kompozit Yayı" /><string id="item_seljuk_heavy_arrows" text="Selçuklu Zırh Delen Temren Okları" /><string id="item_seljuk_bolts" text="Selçuklu Çelik Temrenli Kundak Okları" /><string id="item_seljuk_turkoman_horse" text="Asil Türkmen Savaş Atı" /><string id="seljuk_faction_desc" text="Büyük Selçuklu Devleti; Horasan'dan Anadolu içlerine kadar uzanan, adaleti, Nizamiye medreseleri ve yenilmez Türkmen süvarileriyle Calradia bozkırlarına ve kadim şehirlerine hükmeden ulu cihan devletidir." /><string id="policy_futuwwa_nizam_name" text="Fütüvvet Nizamı" /><string id="policy_futuwwa_nizam_desc" text="Şehirlerdeki zanaatkar ocakları ve atölye gelirleri %30 artar, şehir asayişi güçlenir." /><string id="policy_uc_gazileri_name" text="Uç Gazileri Teşkilatı" /><string id="policy_uc_gazileri_desc" text="Sınır boylarında gaziler ve alpler teşkilatlandırılır. Lordların ve klanların birlik kapasitesi +25 asker artar." /><string id="policy_kervansaray_berati_name" text="Kervansaray Beratı" /><string id="policy_kervansaray_berati_desc" text="İpek Yolu üzerindeki kervansaraylara özel sultanlık beratı verilir. Şehirlerin refahı her gün +1 kalıcı olarak yükselir." /><string id="seljuk_bard_opt" text="Bozkır Ozanından Gazavat Destanı Dinle (100 Dinar)" /><string id="seljuk_bard_no_gold" text="Yeterli altınınız yok (100 Dinar gerekli)." /><string id="seljuk_bard_notif" text="Ozanın kopuzundan dökülen Selçuklu gazavat destanı erlerin yüreğini coşturdu! (+15 Ordu Morali)" /><string id="seljuk_alp_arslan_greet" text="Gaza meydanlarının yiğit alpi! Hoş geldin, kılıcın keskin, nizamın daim olsun. Âl-i Selçuk'un fermanı ve himmeti üzerinedir. Ne dilersin?" /><string id="seljuk_ertugrul_greet" text="Ey gaza yoldaşım! Söğüt uç boyundan ve Kayı otağından sana bin selam olsun. Pusatın daim parlasın, ne murat edersin?" /><string id="seljuk_nizam_greet" text="Adaletin ve nizamın kılıcı keskindir evlat. Devlet-i Âliyye'ye hizmetin daim olsun. Buyur, seni dinlerim." /><string id="seljuk_starter_notif" text="Büyük Selçuklu Gazi Başlangıç Paketi envanterinize tanımlandı! (+2.500 Dinar, Asil Türkmen Atı, Kompozit Yay ve Zırh Delen Oklar)" /><string id="clan_seljuk_royal" text="Âl-i Selçuk Hanedanı" /><string id="clan_nizamiye" text="Nizamiye Divanı" /><string id="clan_danismend" text="Danişmendliler Beyliği" /><string id="clan_artuk" text="Artuklular Beyliği" /><string id="clan_mengucek" text="Mengücekliler Melikliği" /><string id="clan_saltuk" text="Saltuklular Beyliği" /><string id="clan_caka" text="Çaka Beyliği" /><string id="clan_ahlatsah" text="Ahlatşahlar Beyliği" /><string id="clan_karaman" text="Karamanoğulları Beyliği" /><string id="clan_kayi_oguz" text="Kayı Boyu Alpleri" /><string id="clan_ahi_order" text="Ahilik Teşkilatı" />
