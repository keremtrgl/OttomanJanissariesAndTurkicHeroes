<?xml version="1.0" encoding="utf-8"?>
<Kingdoms>
  <!-- BÜYÜK SELÇUKLU DEVLETİ ANA KRALLIK TANIMI (ENCYCLOPEDIA & MAP ENTITY) -->
  <Kingdom id="kingdom_seljuks"
           name="{=seljuk_faction_name}Büyük Selçuklu Devleti"
           short_name="{=seljuk_faction_short}Selçuklular"
           title="{=seljuk_faction_title}Sultanlık"
           ruler_title="{=seljuk_ruler_title}Sultan"
           culture="Culture.seljuk"
           owner="Hero.lord_seljuk_alp_arslan"
           banner_key="11.142.142.1536.1536.768.768.1.0.0.103.143.143.512.512.768.768.1.0.0"
           primary_banner_color="0xFF168B8D"
           secondary_banner_color="0xFFD4AF37"
           color="0xFF168B8D"
           color2="0xFFD4AF37"
           settlement_banner_mesh="encounter_flag_a"
           flag_mesh="info_screen_flags_b"
           initial_home_settlement="Settlement.town_ES1"
           text="{=seljuk_faction_desc}Büyük Selçuklu Devleti; Horasan'dan Anadolu içlerine kadar uzanan, adaleti, Nizamiye medreseleri ve yenilmez Türkmen süvarileriyle Calradia bozkırlarına ve kadim şehirlerine hükmeden ulu cihan devletidir.">
    <!-- value="-30" (was) sat right at the AI's quick-war threshold and put the Seljuks and Bizans
         at war within the first few in-game days of every campaign - same bug class already fixed
         for Kingdom.empire in b133b3c, just never applied here. 0 keeps genuine rivalry in the text
         without auto-triggering a start-of-game war. -->
    <relationships>
      <relationship kingdom="Kingdom.empire_s" value="0" />
      <relationship kingdom="Kingdom.aserai" value="20" />
      <relationship kingdom="Kingdom.khuzait" value="15" />
      <relationship kingdom="Kingdom.sturgia" value="0" />
    </relationships>
  </Kingdom>

  <!-- ================================================================================= -->
  <!-- DÖNEME AİT KOMŞU/RAKİP DEVLETLER (Sadece isim/unvan/açıklama override'ı;              -->
  <!-- birlikler, kahramanlar ve oynanış mekanikleri Native'de tanımlı haliyle kalır.)        -->
  <!-- ================================================================================= -->

  <!-- BİZANS İMPARATORLUĞU (Native: Southern Empire / empire_s) -->
  <!-- banner_key eksikti - kingdoms.xml'de bir Kingdom sadece kismi override alsa da banner_key
       hic belirtilmeyince oyun icinde kirik/varsayilan bir bayrak render ediliyordu (Native'in kendi
       empire_s banner_key'i miras alinmiyor). Asagidaki key, Native'in orijinal empire_s bayragiyla
       AYNI yapi/ikon (162) - sadece renk paleti index'leri kullanicinin istedigi C32ACE mora
       (palet id 79, en yakin gecerli renk: 0xffA34FAF) ve mevcut altin vurguya (palet id 7,
       0xffDEA940, D4AF37'ye zaten cok yakin) cekildi. Ayni banner_key, Diogenes Hanedani'nin
       (clan_empire_south_1) klan bayragiyla da eslesiyor - bkz. byzantine_clans.xml. -->
  <Kingdom id="empire_s"
           name="{=seljuk_byzantine_name}Bizans İmparatorluğu"
           short_name="{=seljuk_byzantine_short}Bizans"
           title="{=seljuk_byzantine_title}Bizans İmparatorluğu"
           ruler_title="{=seljuk_byzantine_ruler}İmparator"
           text="{=seljuk_byzantine_desc}Malazgirt sonrası Anadolu'da direnen Bizans'ın güney kanadı. Büyük Selçuklu Devleti'nin en amansız rakibi; Konya ve İsfahan'a doğru genişleyen Türkmen boylarına karşı sınır kalelerini elinde tutmaya çalışır."
           banner_key="11.79.79.4345.4345.764.764.1.0.0.162.7.7.512.512.764.764.1.0.0"
           primary_banner_color="0xFFC32ACE"
           secondary_banner_color="0xFFD4AF37"
           color="0xFFC32ACE"
           color2="0xFFD4AF37">
    <!-- Native ships empire_s already at war with aserai on day 1 (spkingdoms.xml) - under our
         renames that's Bizans vs Abbasi at war from the very start of every campaign. -->
    <relationships>
      <relationship kingdom="Kingdom.aserai" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>

  <!-- ABBASİ HALİFELİĞİ (Native: Sultanate of the Aserai / aserai) -->
  <!-- Ayni banner_key eksikligi buradaydi da - Native'in kendi aserai bayragi/renkleri geri eklendi. -->
  <Kingdom id="aserai"
           name="{=seljuk_abbasid_name}Abbasi Halifeliği"
           short_name="{=seljuk_abbasid_short}Abbasiler"
           title="{=seljuk_abbasid_title}Abbasi Halifeliği"
           ruler_title="{=seljuk_abbasid_ruler}Halife"
           text="{=seljuk_abbasid_desc}Bağdat merkezli halifelik; İslam dünyasının nominal başı olsa da gerçek askeri güç artık Büyük Selçuklu sultanlarının elindedir. Sultan, Halife'nin koruyucusu ve fiili hükümdarıdır."
           banner_key="11.0.0.4345.4345.764.764.1.0.0.463.1.1.466.466.764.764.1.0.0"
           primary_banner_color="0xffB57A1E"
           secondary_banner_color="0xff4E1A13"
           color="0xffB57A1E"
           color2="0xff4E1A13">
    <relationships>
      <relationship kingdom="Kingdom.empire_s" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>

  <!-- GÜRCİSTAN KRALLIĞI (Native: Principality of Sturgia / sturgia) -->
  <!-- Ayni banner_key eksikligi buradaydi da - Native'in kendi sturgia bayragi/renkleri geri eklendi. -->
  <Kingdom id="sturgia"
           name="{=seljuk_georgia_name}Gürcistan Krallığı"
           short_name="{=seljuk_georgia_short}Gürcüler"
           title="{=seljuk_georgia_title}Gürcistan Krallığı"
           ruler_title="{=seljuk_georgia_ruler}Kral"
           text="{=seljuk_georgia_desc}Kafkas dağlarının eteklerinde hüküm süren Hristiyan krallık. Büyük Selçuklu akıncılarıyla sınır boylarında sık sık çatışan, bağımsızlığını korumakta kararlı bir kuzey komşusu."
           banner_key="11.12.12.4345.4345.764.764.1.0.0.462.13.13.512.512.764.764.1.0.0"
           primary_banner_color="0xff224277"
           secondary_banner_color="0xffCEDAE7"
           color="0xff224277"
           color2="0xffCEDAE7">
    <!-- Native ships sturgia already at war with vlandia on day 1 (spkingdoms.xml). -->
    <relationships>
      <relationship kingdom="Kingdom.vlandia" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>

  <!-- ================================================================================= -->
  <!-- Native'in varsayilan kampanya baslangicinda ZATEN savasta olan 4 kral ciftinden      -->
  <!-- ikisi yukarida (Bizans-Abbasi, Gurcistan-Vlandia) temizlendi. Kalan iki cift bu       -->
  <!-- modun hic dokunmadigi Native krallıklarını ilgilendiriyor (Kuzey Imparatorlugu vs     -->
  <!-- Khuzait, Bati Imparatorlugu vs Battania) ama oyuncu "tum krallıklar savasta           -->
  <!-- basliyor" diye bildirdigi icin bunlar da barisa cekildi - isim/kultur/banner gibi     -->
  <!-- baska hicbir sey degistirilmedi, sadece baslangic savas durumu.                       -->
  <!-- ================================================================================= -->
  <Kingdom id="vlandia">
    <relationships>
      <relationship kingdom="Kingdom.sturgia" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>
  <Kingdom id="battania">
    <relationships>
      <relationship kingdom="Kingdom.empire_w" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>
  <Kingdom id="empire">
    <relationships>
      <relationship kingdom="Kingdom.khuzait" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>
  <Kingdom id="empire_w">
    <relationships>
      <relationship kingdom="Kingdom.battania" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>
  <Kingdom id="khuzait">
    <relationships>
      <relationship kingdom="Kingdom.empire" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>
</Kingdoms>