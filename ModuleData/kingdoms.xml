<?xml version="1.0" encoding="utf-8"?>
<Kingdoms>
  <!-- BÜYÜK SELÇUKLU DEVLETİ ANA KRALLIK TANIMI (ENCYCLOPEDIA & MAP ENTITY) -->
  <Kingdom id="kingdom_seljuks"
           name="{=seljuk_faction_name}Great Seljuk Empire"
           short_name="{=seljuk_faction_short}Seljuks"
           title="{=seljuk_faction_title}Sultanate"
           ruler_title="{=seljuk_ruler_title}Sultan"
           culture="Culture.seljuk"
           owner="Hero.lord_seljuk_alp_arslan"
           banner_key="11.142.142.1536.1536.768.768.1.0.0.103.143.143.512.512.768.768.1.0.0"
           primary_banner_color="0xFF168B8D"
           secondary_banner_color="0xFFD4AF37"
           color="0xFF168B8D"
           color2="0xFFD4AF37"
           settlement_banner_mesh="encounter_flag_a"
           flag_mesh="info_screen_flags_b"
           initial_home_settlement="Settlement.town_ES1"
           text="{=seljuk_faction_desc}The Great Seljuk Empire; spanning from Khorasan to the heart of Anatolia, ruling Calradia's steppes and ancient cities with justice, Nizamiya institutions, and invincible Turkoman horsemen.">
    <!-- value="-30" (was) sat right at the AI's quick-war threshold and put the Seljuks and Bizans
         at war within the first few in-game days of every campaign - same bug class already fixed
         for Kingdom.empire in b133b3c, just never applied here. 0 keeps genuine rivalry in the text
         without auto-triggering a start-of-game war. -->
    <relationships>
      <relationship kingdom="Kingdom.empire_s" value="0" />
      <relationship kingdom="Kingdom.aserai" value="20" />
      <relationship kingdom="Kingdom.khuzait" value="15" />
      <relationship kingdom="Kingdom.sturgia" value="0" />
    </relationships>
  </Kingdom>

  <!-- ================================================================================= -->
  <!-- DÖNEME AİT KOMŞU/RAKİP DEVLETLER (Sadece isim/unvan/açıklama override'ı;              -->
  <!-- birlikler, kahramanlar ve oynanış mekanikleri Native'de tanımlı haliyle kalır.)        -->
  <!-- ================================================================================= -->

  <!-- BİZANS İMPARATORLUĞU (Native: Southern Empire / empire_s) -->
  <!-- banner_key eksikti - kingdoms.xml'de bir Kingdom sadece kismi override alsa da banner_key
       hic belirtilmeyince oyun icinde kirik/varsayilan bir bayrag render ediliyordu (Native'in kendi
       empire_s banner_key'i miras alinmiyor). Bayragin kendisi (ikon 162, cift basli kartal) artik
       dogru render ediyor - ilk turda palet id 79 (0xffA34FAF) kullanildi ama bu, istenen C32ACE'e
       kiyasla doygunlugu dusuk ("soluk") bir ton. Oyunun bayrak renk paleti sabit ~230 renkten
       olustugu icin tam C32ACE hex'i mumkun degil; bunun yerine palet id 71 (0xff710083) secildi -
       C32ACE'e cok yakin ayni mor/menekse tonu (hue farki ~4 derece) ama %100 doygunlukta, koyu/canli
       "emperyal mor" (Bizans imparatorlarinin tarihi "porphyra" rengine de yakin) - "soluk" sorununu
       coker. Ayni banner_key, Diogenes Hanedani'nin (clan_empire_south_1) klan bayragiyla da
       eslesiyor - bkz. byzantine_clans.xml. -->
  <Kingdom id="empire_s"
           name="{=seljuk_byzantine_name}Byzantine Empire"
           short_name="{=seljuk_byzantine_short}Byzantium"
           title="{=seljuk_byzantine_title}Byzantine Empire"
           ruler_title="{=seljuk_byzantine_ruler}Emperor"
           text="{=seljuk_byzantine_desc}The southern wing of the Byzantine resistance in Anatolia after Manzikert. The Great Seljuk Empire's most implacable rival, struggling to hold its border fortresses against the Turkoman tribes advancing on Konya and Isfahan."
           banner_key="11.71.71.4345.4345.764.764.1.0.0.162.7.7.512.512.764.764.1.0.0"
           primary_banner_color="0xFF710083"
           secondary_banner_color="0xFFD4AF37"
           color="0xFF710083"
           color2="0xFFD4AF37">
    <!-- Native ships empire_s already at war with aserai on day 1 (spkingdoms.xml) - under our
         renames that's Bizans vs Abbasi at war from the very start of every campaign. -->
    <relationships>
      <relationship kingdom="Kingdom.aserai" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>

  <!-- ABBASİ HALİFELİĞİ (Native: Sultanate of the Aserai / aserai) -->
  <!-- Native'in kendi aserai bayragi altin/kahverengiydi (id 0/1); tarihi Abbasi bayragi ise
       "Ar-Rayah" / Kara Sancak - siyah zemin. Native'in banner_icons.xml paletinde tam siyah
       yok ama id 116 (0xff0B0C11) neredeyse ayirt edilemeyecek kadar yakin; ikon katmani da
       goze carpsin diye id 172 (0xffffffff, sade beyaz) secildi - Ar-Rayah'in uzerindeki beyaz
       kelime-i tevhid yazisina da uygun bir kontrast. Hukumdar hanedani clan_aserai_1'in
       banner_key'i de (abbasid_clans.xml) ayni degere cekildi, Bizans/Gurcistan'da yapildigi gibi. -->
  <Kingdom id="aserai"
           name="{=seljuk_abbasid_name}Abbasid Caliphate"
           short_name="{=seljuk_abbasid_short}Abbasids"
           title="{=seljuk_abbasid_title}Abbasid Caliphate"
           ruler_title="{=seljuk_abbasid_ruler}Caliph"
           text="{=seljuk_abbasid_desc}The Baghdad-based Caliphate, nominal head of the Islamic world though real military power now rests with the Great Seljuk Sultans. The Sultan stands as the Caliph's protector and de facto ruler."
           banner_key="11.116.116.4345.4345.764.764.1.0.0.463.172.172.466.466.764.764.1.0.0"
           primary_banner_color="0xff0B0C11"
           secondary_banner_color="0xffffffff"
           color="0xff0B0C11"
           color2="0xffffffff">
    <relationships>
      <relationship kingdom="Kingdom.empire_s" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>

  <!-- GÜRCİSTAN KRALLIĞI (Native: Principality of Sturgia / sturgia) -->
  <!-- Ayni banner_key eksikligi buradaydi da, ama Native'in kendi mavi/gri renklerini geri koymak
       yerine gercek Gurcu krallik bayragina uygun beyaz zemin + kirmizi (hac) vurgusuna cevrildi
       (kullanicinin talebi: "beyaz" olmali, mavi degil). Palette'te tam beyaz (id 172) ve yakin bir
       kirmizi (id 83) mevcut. Ayni banner_key, hukumdar hanedani Bagrationi'nin (clan_sturgia_1)
       klan bayragiyla da eslesiyor - bkz. georgian_clans.xml. -->
  <Kingdom id="sturgia"
           name="{=seljuk_georgia_name}Kingdom of Georgia"
           short_name="{=seljuk_georgia_short}Georgians"
           title="{=seljuk_georgia_title}Kingdom of Georgia"
           ruler_title="{=seljuk_georgia_ruler}King"
           text="{=seljuk_georgia_desc}A Christian kingdom ruling in the shadow of the Caucasus mountains. A northern neighbor determined to keep its independence, frequently clashing with Great Seljuk raiders along the frontier."
           banner_key="11.172.172.4345.4345.764.764.1.0.0.462.83.83.512.512.764.764.1.0.0"
           primary_banner_color="0xFFFFFFFF"
           secondary_banner_color="0xFFD22D33"
           color="0xFFFFFFFF"
           color2="0xFFD22D33">
    <!-- Native ships sturgia already at war with vlandia on day 1 (spkingdoms.xml). -->
    <relationships>
      <relationship kingdom="Kingdom.vlandia" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>

  <!-- ================================================================================= -->
  <!-- Native'in varsayilan kampanya baslangicinda ZATEN savasta olan 4 kral ciftinden      -->
  <!-- ikisi yukarida (Bizans-Abbasi, Gurcistan-Vlandia) temizlendi. Kalan iki cift bu       -->
  <!-- modun hic dokunmadigi Native krallıklarını ilgilendiriyor (Kuzey Imparatorlugu vs     -->
  <!-- Khuzait, Bati Imparatorlugu vs Battania) ama oyuncu "tum krallıklar savasta           -->
  <!-- basliyor" diye bildirdigi icin bunlar da barisa cekildi - isim/kultur/banner gibi     -->
  <!-- baska hicbir sey degistirilmedi, sadece baslangic savas durumu.                       -->
  <!-- ================================================================================= -->
  <!-- HAÇLI DEVLETLERİ (Native: Kingdom of Vlandia / vlandia) -->
  <!-- Antakya Prensliği ve Urfa Kontluğu, ikisi de 1098'de Birinci Haçlı Seferi sirasinda kuruldu -
       Urfa, Artuklu/Danismendli/Selcuklu beyliklerinin dogrudan sinirdasi (bkz. crusader_lords.xml).
       Renk paleti duzeltildi: Bohemond'un ait oldugu Hauteville hanedaninin gercek/belgelenmis
       arma rengi lacivert (azure) + kirmizi/gumus damali serittir (Wikimedia Commons/WappenWiki
       kaynaklarindan dogrulandi) - ilk secilen altin/kirmizi kombinasyonu tarihi kaynagi olmayan
       bir tahmindi, duzeltildi. Palet id 202 (0xFF2A5599, lacivert) + id 83 (0xffD22D33, kirmizi -
       Gurcistan'in da ikincil rengi ama ana/zemin rengi tamamen farkli oldugu icin bayraklar
       birbirine karismiyor; ayrica lacivert bu modda baska hicbir krallikta kullanilmiyor).
       banner_key, Vlandia'nin kendi Native mesh/boyut/pozisyon yapisini korur, sadece renk
       index'leri degisti. -->
  <Kingdom id="vlandia"
           name="{=crus_faction_name}Crusader States"
           short_name="{=crus_faction_short}Crusaders"
           title="{=crus_faction_title}Principality of Antioch"
           ruler_title="{=crus_faction_ruler}Prince"
           text="{=crus_faction_desc}Frankish and Norman lords who marched east on the First Crusade and carved out the Principality of Antioch and the County of Edessa in 1098. Their new domain borders the Seljuk-aligned Artuqid and Danishmendid beyliks directly, making them a frequent combatant on the Great Seljuk Empire's western frontier."
           banner_key="11.202.202.1536.1536.764.764.1.0.0.160.83.83.497.497.764.764.1.0.0"
           primary_banner_color="0xFF2A5599"
           secondary_banner_color="0xffD22D33"
           color="0xFF2A5599"
           color2="0xffD22D33">
    <relationships>
      <relationship kingdom="Kingdom.sturgia" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>
  <!-- KİLİKYA ERMENİ PRENSLİĞİ (Native: High Kingdom of the Battanians / battania) -->
  <!-- Rubenli hanedanligi, 1080 civarinda Ruben I'in Bizans'a karsi ayaklanmasiyla kuruldu -
       modun kendi zaman cizelgesiyle (1071 Malazgirt - 1125 civari) tam ortusuyor. Renk paleti:
       Rubenli hanedaninin gercek/belgelenmis armasi "Gules, a Lion passant guardant holding a
       cross Or" - yani kirmizi zemin + altin renkli aslan (Wikimedia Commons/PeopleOfAr
       kaynaklarindan dogrulandi). Native'in kendi yesil/acik-mavi rengi bu yuzden KORUNMADI, gercek
       tarihi renklerle degistirildi: palet id 48 (0xffe44434, kirmizi zemin - Gurcistan/Haclilarin
       ikincil kirmizisindan (id 83) farkli bir ton, ana renk olarak kullanildigi icin karismiyor)
       + id 7 (0xffDEA940, altin aslan vurgusu). -->
  <Kingdom id="battania"
           name="{=arm_faction_name}Cilician Armenia"
           short_name="{=arm_faction_short}Armenians"
           title="{=arm_faction_title}Principality of Cilician Armenia"
           ruler_title="{=arm_faction_ruler}Prince"
           text="{=arm_faction_desc}An Armenian mountain principality founded around 1080 when Ruben I broke away from Byzantine rule in the Taurus range. Its lords hold their fortresses in a loose, often quarrelsome confederation, but unite readily against outside claims on Cilicia from Byzantium, the Crusader principalities, or the Great Seljuk Empire."
           banner_key="11.48.48.1536.1536.764.764.1.0.0.460.7.7.457.457.764.764.1.0.0"
           primary_banner_color="0xffe44434"
           secondary_banner_color="0xffDEA940"
           color="0xffe44434"
           color2="0xffDEA940">
    <relationships>
      <relationship kingdom="Kingdom.empire_w" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>
  <Kingdom id="empire">
    <relationships>
      <relationship kingdom="Kingdom.khuzait" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>
  <Kingdom id="empire_w">
    <relationships>
      <relationship kingdom="Kingdom.battania" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>
  <!-- KARAHANLI DEVLETI (Native: Khuzait Khanate / khuzait). Real Kara-Khanid Khanate (840-1212),
       the Great Seljuks' actual historical eastern neighbor/rival over Transoxiana and Khorasan -
       Alp Arslan's own predecessors served under the Kara-Khanid ruler Ali-Tegin in Bukhara in the
       1020s before their falling-out in 1034. Split into a Western Khanate (Transoxiana, capital
       Samarkand/Bukhara) and an Eastern Khanate (Kashgar/Khotan/Balasagun) since the 1030s-40s -
       both are folded into this one Kingdom entry, matching how Byzantine absorbed the Northern
       Empire. Ruler title "Khagan" (Qara-Khagan) is the real supreme Kara-Khanid title, distinct
       from Sultan/Caliph/Emperor. Banner: primary black (id 116, 0xff0B0C11) for the "Kara" (black/
       great) in the dynasty's own name, secondary a vivid sky-blue (id 234, 0xff3995f8) for "Kok"
       (sky) - the sacred color of Turkic Tengri/sky worship inherited from the Kara-Khanids'
       Gokturk-descended Karluk/Yaghma tribal roots. Uses khuzait's own reserved icon mesh (461),
       same convention as Crusader States reusing Vlandia's reserved icon (160). -->
  <Kingdom id="khuzait"
           name="{=krkh_faction_name}Kara-Khanid Khanate"
           short_name="{=krkh_faction_short}Kara-Khanids"
           title="{=krkh_faction_title}Khanate"
           ruler_title="{=krkh_ruler_title}Khagan"
           text="{=krkh_faction_desc}The Kara-Khanid Khanate, a great Turkic steppe power split between a Western Khanate centered on Samarkand and Bukhara and an Eastern Khanate centered on Kashgar, Khotan, and Balasagun. The Great Seljuk Empire's eastern rival over Transoxiana and Khorasan - and, a generation ago, the very land where Sultan Alp Arslan's own predecessors first served as steppe chieftains."
           banner_key="11.116.116.4345.4345.764.764.1.0.0.461.234.234.512.512.764.764.1.0.0"
           primary_banner_color="0xff0B0C11"
           secondary_banner_color="0xff3995f8"
           color="0xff0B0C11"
           color2="0xff3995f8">
    <relationships>
      <relationship kingdom="Kingdom.empire" value="0" isAtWar="false" />
    </relationships>
  </Kingdom>
</Kingdoms>